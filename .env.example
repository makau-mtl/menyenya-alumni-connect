# Copy to .env.local for local work. Never commit .env.local.
# Without these, the site runs on sample data.

# Supabase → Project Settings → API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (starts with sb_publishable_). The older "anon" key also works,
# set as NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sign-in buttons to show, matching providers switched on in Supabase (see docs/SETUP-SIGN-IN.md).
# Comma-separated: google, linkedin_oidc, azure, apple. Leave empty to show email links only.
NEXT_PUBLIC_AUTH_PROVIDERS=
